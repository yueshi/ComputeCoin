@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  
  body {
    transition: background-color 0.3s ease, color 0.3s ease;
  }
}

/* RainbowKit 主题样式增强 */
@layer utilities {
  /* 自定义 RainbowKit 主题变量 */
  :root {
    --rk-backdrop-filter: blur(8px);
  }
  
  .dark {
    --rk-backdrop-filter: blur(12px);
  }
}

/* RainbowKit 主题微调 - 新品牌主题 */
@layer components {
  /* 为深色模式提供更好的对比度 */
  .dark {
    /* 增强钱包连接按钮的可见性 */
  }

  /* 调整钱包选择器和网络切换器样式 */
  [data-rk] .rk-wallet-button,
  [data-rk] .rk-chain-button {
    transition: all 0.2s ease;
  }

  /* 自定义网络切换器颜色 - 使用新的品牌色 */
  [data-rk] .rk-chain-button:hover {
    background-color: rgba(14, 165, 233, 0.1);
  }

  .dark [data-rk] .rk-chain-button:hover {
    background-color: rgba(14, 165, 233, 0.2);
  }

  /* 自定义网络选择器中的活跃网络 */
  [data-rk] .rk-chain-item[data-active] {
    background-color: rgba(14, 165, 233, 0.1);
    border-color: #0ea5e9;
  }

  .dark [data-rk] .rk-chain-item[data-active] {
    background-color: rgba(14, 165, 233, 0.2);
    border-color: #0ea5e9;
  }

  /* 自定义网络选择器hover状态 */
  [data-rk] .rk-chain-item:hover {
    background-color: rgba(14, 165, 233, 0.05);
  }

  .dark [data-rk] .rk-chain-item:hover {
    background-color: rgba(14, 165, 233, 0.1);
  }

  /* 自定义连接对话框样式 - 品牌渐变顶部 */
  [data-rk] .rk-dialog {
    border-top: 3px solid transparent;
    background-image: linear-gradient(90deg, #0ea5e9 0%, #a855f7 50%, #d946ef 100%);
    background-origin: border-box;
    background-clip: border-box;
    background-position: top;
    background-size: 100% 3px;
    background-repeat: no-repeat;
  }

  /* 自定义钱包列表项hover状态 */
  [data-rk] .rk-wallet-option:hover {
    background-color: rgba(14, 165, 233, 0.05);
  }

  .dark [data-rk] .rk-wallet-option:hover {
    background-color: rgba(14, 165, 233, 0.1);
  }

  /* 改善 QR 码显示 - 品牌色边框 */
  [data-rk] .rk-qr-code {
    border-radius: 12px;
    border: 2px solid #0ea5e9;
    box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.1);
  }

  /* 自定义断开连接按钮 */
  [data-rk] .rk-disconnect-button:hover {
    background-color: rgba(239, 68, 68, 0.1);
  }

  .dark [data-rk] .rk-disconnect-button:hover {
    background-color: rgba(239, 68, 68, 0.2);
  }

  /* 自定义连接按钮样式 */
  [data-rk] .rk-connect-button {
    background: linear-gradient(135deg, #0ea5e9 0%, #a855f7 50%, #d946ef 100%);
    border: none;
    box-shadow: 0 4px 14px 0 rgba(14, 165, 233, 0.3);
    transition: all 0.2s ease;
  }

  [data-rk] .rk-connect-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px 0 rgba(14, 165, 233, 0.4);
  }

  /* 钱包下拉菜单样式 */
  [data-rk] .rk-dropdown-menu {
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  .dark [data-rk] .rk-dropdown-menu {
    border-color: #334155;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  }
}

@layer components {
  // 主按钮样式 - 品牌渐变
  .btn-primary {
    background: linear-gradient(135deg, #0ea5e9 0%, #a855f7 50%, #d946ef 100%);
    color: white;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    outline: none;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .btn-primary:focus {
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.5);
  }

  .btn-primary:hover {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    transform: scale(1.05);
  }

  // 次要按钮样式
  .btn-secondary {
    background-color: white;
    color: #111827;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid #d1d5db;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    outline: none;
  }

  .btn-secondary:hover {
    background-color: #f9fafb;
  }

  .btn-secondary:focus {
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.5);
  }

  .dark .btn-secondary {
    background-color: #1f2937;
    color: #f9fafb;
    border-color: #4b5563;
  }

  .dark .btn-secondary:hover {
    background-color: #374151;
  }

  .dark .btn-secondary:focus {
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.5);
  }

  // 卡片样式
  .card {
    background-color: white;
    border-radius: 0.75rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    padding: 1.5rem;
    border: 1px solid #e5e7eb;
    transition: all 0.2s ease;
  }

  .card:hover {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  }

  .dark .card {
    background-color: #1f2937;
    border-color: #374151;
  }

  // 背景主题样式
  .bg-gradient-theme {
    background: linear-gradient(135deg, #f0f9ff 0%, #faf5ff 50%, #fdf4ff 100%);
  }

  .dark .bg-gradient-theme {
    background: linear-gradient(135deg, #082f49 0%, #3b0764 50%, #4a044e 100%);
  }

  // 文字颜色系统
  .text-theme-primary {
    color: #111827;
  }

  .dark .text-theme-primary {
    color: #f9fafb;
  }

  .text-theme-secondary {
    color: #4b5563;
  }

  .dark .text-theme-secondary {
    color: #d1d5db;
  }

  .text-theme-tertiary {
    color: #6b7280;
  }

  .dark .text-theme-tertiary {
    color: #9ca3af;
  }

  // 边框颜色系统
  .border-theme {
    border-color: #e5e7eb;
  }

  .dark .border-theme {
    border-color: #374151;
  }

  // 背景颜色系统
  .bg-theme-card {
    background-color: white;
  }

  .dark .bg-theme-card {
    background-color: #1f2937;
  }

  .bg-theme-secondary {
    background-color: #f9fafb;
  }

  .dark .bg-theme-secondary {
    background-color: #111827;
  }

  .bg-theme-tertiary {
    background-color: #f3f4f6;
  }

  .dark .bg-theme-tertiary {
    background-color: #1f2937;
  }

  .bg-theme-input {
    background-color: white;
  }

  .dark .bg-theme-input {
    background-color: #374151;
  }

  // NFT等级颜色系统
  .tier-bronze {
    background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
  }

  .tier-silver {
    background: linear-gradient(135deg, #9ca3af 0%, #6b7280 100%);
  }

  .tier-gold {
    background: linear-gradient(135deg, #eab308 0%, #f59e0b 100%);
  }

  .tier-platinum {
    background: linear-gradient(135deg, #a855f7 0%, #9333ea 100%);
  }

  // 状态指示器
  .status-success {
    background-color: #d1fae5;
    color: #065f46;
    border: 1px solid #6ee7b7;
  }

  .status-warning {
    background-color: #fef3c7;
    color: #92400e;
    border: 1px solid #fde047;
  }

  .status-error {
    background-color: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
  }

  .status-info {
    background-color: #dbeafe;
    color: #1e40af;
    border: 1px solid #60a5fa;
  }
}

/* 通知动画样式 - 参考staking页面 */
@layer utilities {
  /* 通知滑入动画 */
  .animate-slide-in-right {
    animation: slideInRight 0.3s ease-out forwards;
  }
  
  @keyframes slideInRight {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }
  
  /* 进度条收缩动画 */
  @keyframes shrink-width {
    from {
      width: 100%;
    }
    to {
      width: 0%;
    }
  }
  
  /* 通知悬停动画 */
  .notification-hover:hover {
    transform: scale(1.02);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }
  
  .notification-hover {
    transition: all 0.2s ease;
  }
  
  /* 通知淡出动画 */
  .animate-fade-out {
    animation: fadeOut 0.3s ease-in forwards;
  }
  
  @keyframes fadeOut {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(100%);
    }
  }
}